{
  "cleanUrls": true,
  "outputDirectory": "web_app",
  "rewrites": [
    {
      "source": "/download-notebook",
      "destination": "/gradela_notebook.ipynb"
    },
    {
      "source": "/web_app/index.html",
      "destination": "/index.html"
    },
    {
      "source": "/web_app/:path*",
      "destination": "/:path*"
    }
  ]
}
